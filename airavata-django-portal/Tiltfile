# Tiltfile for Airavata Django Portal

# --- Django backend dev server ---
local_resource(
    'django-server',
    serve_env={'DJANGO_SETTINGS_MODULE': 'django_airavata.settings'},
    serve_cmd=' && '.join([
        'uv sync',
        'uv run manage.py migrate --run-syncdb',
        'uv run manage.py runserver 0.0.0.0:8000',
    ]),
    deps=['django_airavata/'],
    ignore=[
        '**/node_modules',
        '**/static/django_airavata_*/*.js',
        '**/static/django_airavata_*/*.css',
        '**/static/common/dist',
    ],
    readiness_probe=probe(
        http_get=http_get_action(port=8000, path='/health/'),
        initial_delay_secs=10,
        period_secs=5,
    ),
    links=[
        link('http://localhost:8000', 'Portal'),
    ],
)

# --- Frontend: install + production build for all packages ---
# All apps get a production build first. The active dev app (below) then
# starts a Vite dev server with HMR for hot reload on port 9000.
local_resource(
    'frontend-build',
    cmd='yarn install && yarn workspaces run build',
    resource_deps=['django-server'],
    labels=['frontend'],
)

# --- Frontend: Vite dev server for the active app (HMR on port 9000) ---
# Only one app can run HMR at a time. Change VITE_DEV_APP in settings_local.py
# and toggle the matching resource here.

FRONTEND_APPS = {
    'admin':       'django_airavata/apps/admin',
    'auth':        'django_airavata/apps/auth',
    'dataparsers': 'django_airavata/apps/dataparsers',
    'workspace':   'django_airavata/apps/workspace',
}

for name, path_prefix in FRONTEND_APPS.items():
    local_resource(
        'frontend-' + name,
        serve_cmd='yarn run dev',
        serve_dir=path_prefix,
        resource_deps=['frontend-build'],
        labels=['frontend-apps'],
        auto_init=(name == 'workspace'),
        links=[link('http://localhost:9000', name + ' (HMR)')],
    )

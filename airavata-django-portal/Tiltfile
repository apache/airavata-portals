# Tiltfile for Airavata Django Portal

# --- Bootstrap settings_local.py on fresh clone ---
# Fetches the Keycloak `pga` client secret and renders django_airavata/settings_local.py
# if missing. Idempotent — skips if the file is already present. Uses stdlib only so
# it runs without `uv sync` first.
local_resource(
    'settings-bootstrap',
    cmd='python3 scripts/bootstrap_settings_local.py',
    deps=['scripts/bootstrap_settings_local.py'],
)

# --- Django backend dev server ---
local_resource(
    'django-server',
    serve_env={'DJANGO_SETTINGS_MODULE': 'django_airavata.settings'},
    resource_deps=['settings-bootstrap'],
    serve_cmd=' && '.join([
        'uv sync',
        'uv run manage.py migrate --run-syncdb',
        # First-run bootstrap of Wagtail CMS pages. load_cms_data replaces the default
        # "localhost" Site with the Airavata-branded one, so we check for that to decide
        # whether bootstrap has already happened. The outer `|| true` makes the CMS
        # load non-fatal — the shipped fixture references a stale wagtailcore.pagerevision
        # model name and won't deserialize against current Wagtail, but the portal is
        # otherwise functional with Wagtail's default Site. Remove `|| true` after
        # regenerating the fixture (see docs/dev/wagtail_export.md).
        '(uv run manage.py shell -c "from wagtail.models import Site; import sys; sys.exit(0 if Site.objects.exclude(hostname=\\\"localhost\\\").exists() else 1)" || uv run manage.py load_cms_data new_default_theme || echo "warning: CMS fixture load failed; portal will use Wagtail default site")',
        'uv run manage.py runserver 0.0.0.0:8000',
    ]),
    deps=['django_airavata/'],
    ignore=[
        '**/node_modules',
        '**/static/django_airavata_*/*.js',
        '**/static/django_airavata_*/*.css',
        '**/static/common/dist',
    ],
    readiness_probe=probe(
        http_get=http_get_action(port=8000, path='/health/'),
        initial_delay_secs=10,
        period_secs=5,
    ),
    links=[
        link('http://localhost:8000', 'Portal'),
    ],
)

# --- Frontend: install + production build for all packages ---
# All apps get a production build first. The active dev app (below) then
# starts a Vite dev server with HMR for hot reload on port 9000.
local_resource(
    'frontend-build',
    cmd='yarn install && yarn workspaces run build',
    resource_deps=['django-server'],
    labels=['frontend'],
)

# --- Frontend: Vite dev server for the active app (HMR on port 9000) ---
# Only one app can run HMR at a time. Change VITE_DEV_APP in settings_local.py
# and toggle the matching resource here.

FRONTEND_APPS = {
    'admin':       'django_airavata/apps/admin',
    'auth':        'django_airavata/apps/auth',
    'dataparsers': 'django_airavata/apps/dataparsers',
    'workspace':   'django_airavata/apps/workspace',
}

for name, path_prefix in FRONTEND_APPS.items():
    local_resource(
        'frontend-' + name,
        serve_cmd='yarn run dev',
        serve_dir=path_prefix,
        resource_deps=['frontend-build'],
        labels=['frontend-apps'],
        auto_init=(name == 'workspace'),
        links=[link('http://localhost:9000', name + ' (HMR)')],
    )

{
  "name": "django-airavata-common-ui",
  "description": "Common UI code for the Airavata Django Portal",
  "version": "1.0.0",
  "author": "Marcus Christie <machristie@apache.org>",
  "private": true,
  "main": "./js/index.js",
  "module": "./js/index.js",
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && vite build --config vite.config.lib.js",
    "build-app": "vite build",
    "build-lib": "vite build --config vite.config.lib.js",
    "lint": "eslint ./js/",
    "format": "prettier --check --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@popperjs/core": "^2.11.8",
    "@uppy/core": "^5.2.0",
    "@uppy/drag-drop": "^5.1.0",
    "@uppy/status-bar": "^5.1.0",
    "@uppy/tus": "^5.1.1",
    "@uppy/xhr-upload": "^5.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.45.6",
    "django-airavata-api": "link:../../apps/api",
    "linkifyjs": "^4.3.3",
    "moment": "^2.30.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1"
  }
}

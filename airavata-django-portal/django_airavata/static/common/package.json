    "@uppy/core": "^5.2.0",
    "@uppy/drag-drop": "^5.1.0",
    "@uppy/status-bar": "^5.1.0",
    "@uppy/tus": "^5.1.1",
    "@uppy/xhr-upload": "^5.2.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "django-airavata-api": "*",
    "linkifyjs": "^4.3.3",
